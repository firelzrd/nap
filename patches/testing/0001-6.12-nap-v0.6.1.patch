+
+/* ================================================================
+ * Weight dump and sideload (sysfs binary attribute "weights")
+ *
+ * Layout: header, then the float32 weights as little-endian words:
+ * first layer rows [NROW][NHID], bias [NHID], output layer [NOUT][NHID],
+ * bias [NOUT].  The same layout as the arrays of nap_weights.h.
+ * ================================================================ */
+
+#define NAP_BLOB_MAGIC	"NAPWGT01"
+#define NAP_BLOB_FMT	1
+#define NAP_PAYLOAD_WORDS \
+	(NAP_NROW * NAP_NHID + NAP_NHID + NAP_NOUT * NAP_NHID + NAP_NOUT)
+
+struct nap_blob_hdr {
+	char magic[8];
+	__le32 fmt;
+	__le32 nt, nk, nd, nhid, nout, first, tail_rep;
+	__le32 payload_bytes;
+	__le32 crc;		/* of the payload */
+	__le32 input_sig;	/* of the input standardisation constants */
+	__le32 reserved;
+};
+#define NAP_BLOB_SIZE \
+	(sizeof(struct nap_blob_hdr) + NAP_PAYLOAD_WORDS * sizeof(__le32))
+
+static DEFINE_MUTEX(nap_wt_lock);
+static int nap_wt_cpu;			/* selected CPU, -1 = all */
+static u8 *nap_wt_snap;			/* last dump */
+static u8 *nap_wt_stage;		/* write in progress */
+static size_t nap_wt_stage_len;
+
+struct nap_wt_xfer {
+	struct nap_cpu *d;
+	__le32 *w;
+	bool ok;
+};
+
+/*
+ * The two functions below run on the CPU that owns the weights, with
+ * interrupts off; nap_select() also runs with interrupts off, so they
+ * cannot interleave with a learning step.  No floating point: words are
+ * copied as bits.
+ */
+static void nap_wt_dump_fn(void *info)
+{
+	struct nap_wt_xfer *x = info;
+	struct nap_cpu *d = x->d;
+	const u32 *src;
+	__le32 *w = x->w;
+	int i, o;
+
+	x->ok = d->inited;
+	if (!x->ok)
+		return;
+	src = (const u32 *)d->w1c;
+	for (i = 0; i < NAP_NROW * NAP_NHID; i++)
+		*w++ = cpu_to_le32(src[i]);
+	src = (const u32 *)d->b1;
+	for (i = 0; i < NAP_NHID; i++)
+		*w++ = cpu_to_le32(src[i]);
+	for (o = 0; o < NAP_NOUT; o++)
+		for (i = 0; i < NAP_NHID; i++)
+			*w++ = cpu_to_le32(((const u32 *)d->w2r[i])[o]);
+	src = (const u32 *)d->b2;
+	for (o = 0; o < NAP_NOUT; o++)
+		*w++ = cpu_to_le32(src[o]);
+}
+
+static void nap_wt_load_fn(void *info)
+{
+	struct nap_wt_xfer *x = info;
+	struct nap_cpu *d = x->d;
+	const __le32 *w = x->w;
+	u32 *dst;
+	int i, o;
+
+	dst = (u32 *)d->w1c;
+	for (i = 0; i < NAP_NROW * NAP_NHID; i++)
+		dst[i] = le32_to_cpu(*w++);
+	dst = (u32 *)d->b1;
+	for (i = 0; i < NAP_NHID; i++)
+		dst[i] = le32_to_cpu(*w++);
+	for (o = 0; o < NAP_NOUT; o++)
+		for (i = 0; i < NAP_NHID; i++)
+			((u32 *)d->w2r[i])[o] = le32_to_cpu(*w++);
+	dst = (u32 *)d->b2;
+	for (o = 0; o < NAP_NOUT; o++)
+		dst[o] = le32_to_cpu(*w++);
+	if (!d->inited) {
+		/* what nap_fpu_init() would set: lambda = 1.0f, the rest 0 */
+		*(u32 *)&d->lambda = 0x3f800000;
+		d->inited = true;
+	}
+	/* the stored activations belong to the old weights */
+	d->fwd_valid = false;
+	d->reset_pending = false;
+	x->ok = true;
+}
+
+static bool nap_wt_run(int cpu, smp_call_func_t fn, struct nap_wt_xfer *x)
+{
+	x->d = nap_cpus[cpu];
+	x->ok = false;
+	if (cpu_online(cpu))
+		smp_call_function_single(cpu, fn, x, 1);
+	else
+		fn(x);		/* nobody else touches an offline CPU's data */
+	return x->ok;
+}
+
+static void nap_blob_fill_hdr(struct nap_blob_hdr *h, u32 crc)
+{
+	memcpy(h->magic, NAP_BLOB_MAGIC, sizeof(h->magic));
+	h->fmt = cpu_to_le32(NAP_BLOB_FMT);
+	h->nt = cpu_to_le32(NAP_NT);
+	h->nk = cpu_to_le32(NAP_NK);
+	h->nd = cpu_to_le32(NAP_ND);
+	h->nhid = cpu_to_le32(NAP_NHID);
+	h->nout = cpu_to_le32(NAP_NOUT);
+	h->first = cpu_to_le32(NAP_GRID_LOG2_FIRST);
+	h->tail_rep = cpu_to_le32(NAP_TAIL_REP_NS);
+	h->payload_bytes = cpu_to_le32(NAP_PAYLOAD_WORDS * sizeof(__le32));
+	h->crc = cpu_to_le32(crc);
+	h->input_sig = cpu_to_le32(nap_fpu_input_sig());
+	h->reserved = 0;
+}
+
+/* 6.16 made the bin_attribute pointers const throughout sysfs */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 16, 0)
+#define NAP_BIN_ATTR_CONST const
+#else
+#define NAP_BIN_ATTR_CONST
+#endif
+
+static ssize_t weights_read(struct file *file, struct kobject *kobj,
+			    NAP_BIN_ATTR_CONST struct bin_attribute *attr,
+			    char *buf, loff_t off, size_t count)
+{
+	ssize_t ret = 0;
+
+	mutex_lock(&nap_wt_lock);
+	if (off == 0) {
+		struct nap_blob_hdr *h = (struct nap_blob_hdr *)nap_wt_snap;
+		struct nap_wt_xfer x;
+
+		if (nap_wt_cpu < 0 || !nap_cpus || !nap_cpus[nap_wt_cpu]) {
+			ret = -EINVAL;
+			goto out;
+		}
+		if (!nap_wt_snap) {
+			nap_wt_snap = kvmalloc(NAP_BLOB_SIZE, GFP_KERNEL);
+			if (!nap_wt_snap) {
+				ret = -ENOMEM;
+				goto out;
+			}
+			h = (struct nap_blob_hdr *)nap_wt_snap;
+		}
+		x.w = (__le32 *)(nap_wt_snap + sizeof(*h));
+		if (!nap_wt_run(nap_wt_cpu, nap_wt_dump_fn, &x)) {
+			/* never ran: nothing learned yet, nothing to dump */
+			ret = -ENODATA;
+			goto out;
+		}
+		nap_blob_fill_hdr(h, crc32_le(~0, (u8 *)x.w,
+					      NAP_PAYLOAD_WORDS * 4));
+	}
+	if (!nap_wt_snap || off >= NAP_BLOB_SIZE)
+		goto out;
+	if (count > NAP_BLOB_SIZE - off)
+		count = NAP_BLOB_SIZE - off;
+	memcpy(buf, nap_wt_snap + off, count);
+	ret = count;
+out:
+	mutex_unlock(&nap_wt_lock);
+	return ret;
+}
+
+/* Reject anything that could upset the network: the header must match this
+ * build exactly, the checksum must hold and every weight must be finite and
+ * below 1024 in magnitude. */
+static int nap_blob_check(const u8 *blob)
+{
+	const struct nap_blob_hdr *h = (const struct nap_blob_hdr *)blob;
+	const __le32 *w = (const __le32 *)(blob + sizeof(*h));
+	int i;
+
+	if (memcmp(h->magic, NAP_BLOB_MAGIC, sizeof(h->magic)) ||
+	    le32_to_cpu(h->fmt) != NAP_BLOB_FMT)
+		return -EPROTO;
+	if (le32_to_cpu(h->nt) != NAP_NT || le32_to_cpu(h->nk) != NAP_NK ||
+	    le32_to_cpu(h->nd) != NAP_ND || le32_to_cpu(h->nhid) != NAP_NHID ||
+	    le32_to_cpu(h->nout) != NAP_NOUT ||
+	    le32_to_cpu(h->first) != NAP_GRID_LOG2_FIRST ||
+	    le32_to_cpu(h->payload_bytes) != NAP_PAYLOAD_WORDS * 4)
+		return -EPROTO;
+	if (le32_to_cpu(h->input_sig) != nap_fpu_input_sig())
+		return -EPROTO;
+	if (le32_to_cpu(h->crc) !=
+	    crc32_le(~0, (const u8 *)w, NAP_PAYLOAD_WORDS * 4))
+		return -EBADMSG;
+	for (i = 0; i < NAP_PAYLOAD_WORDS; i++)
+		if ((le32_to_cpu(w[i]) & 0x7fffffff) >= 0x44800000)
+			return -ERANGE;	/* NaN, Inf or |w| >= 1024 */
+	return 0;
+}
+
+static ssize_t weights_write(struct file *file, struct kobject *kobj,
+			     NAP_BIN_ATTR_CONST struct bin_attribute *attr,
+			     char *buf, loff_t off, size_t count)
+{
+	struct nap_wt_xfer x;
+	ssize_t ret = count;
+	int cpu, err, n = 0;
+
+	mutex_lock(&nap_wt_lock);
+	if (!nap_wt_stage) {
+		nap_wt_stage = kvmalloc(NAP_BLOB_SIZE, GFP_KERNEL);
+		if (!nap_wt_stage) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+	if (off == 0)
+		nap_wt_stage_len = 0;
+	if (off != nap_wt_stage_len || off + count > NAP_BLOB_SIZE) {
+		nap_wt_stage_len = 0;
+		ret = -EINVAL;
+		goto out;
+	}
+	memcpy(nap_wt_stage + off, buf, count);
+	nap_wt_stage_len += count;
+	if (nap_wt_stage_len < NAP_BLOB_SIZE)
+		goto out;		/* wait for the rest */
+	nap_wt_stage_len = 0;
+	err = nap_blob_check(nap_wt_stage);
+	if (err) {
+		pr_warn("nap: weights rejected (%d)\n", err);
+		ret = err;
+		goto out;
+	}
+	x.w = (__le32 *)(nap_wt_stage + sizeof(struct nap_blob_hdr));
+	if (nap_wt_cpu >= 0) {
+		nap_wt_run(nap_wt_cpu, nap_wt_load_fn, &x);
+		n = 1;
+	} else {
+		for_each_possible_cpu(cpu) {
+			if (nap_cpus[cpu]) {
+				nap_wt_run(cpu, nap_wt_load_fn, &x);
+				n++;
+			}
+		}
+	}
+	pr_info("nap: weights loaded into %d CPU(s)\n", n);
+out:
+	mutex_unlock(&nap_wt_lock);
+	return ret;
+}
+
+static ssize_t weights_cpu_show(struct kobject *kobj,
+				struct kobj_attribute *attr, char *buf)
+{
+	if (READ_ONCE(nap_wt_cpu) < 0)
+		return sysfs_emit(buf, "all\n");
+	return sysfs_emit(buf, "%d\n", READ_ONCE(nap_wt_cpu));
+}
+
+static ssize_t weights_cpu_store(struct kobject *kobj,
+				 struct kobj_attribute *attr,
+				 const char *buf, size_t count)
+{
+	unsigned int cpu;
+
+	mutex_lock(&nap_wt_lock);
+	if (sysfs_streq(buf, "all")) {
+		nap_wt_cpu = -1;
+	} else if (!kstrtouint(buf, 10, &cpu) && cpu < nr_cpu_ids &&
+		   cpu_possible(cpu)) {
+		nap_wt_cpu = cpu;
+	} else {
+		mutex_unlock(&nap_wt_lock);
+		return -EINVAL;
+	}
+	mutex_unlock(&nap_wt_lock);
+	return count;
+}
+
+static struct kobj_attribute weights_cpu_attr = __ATTR_RW(weights_cpu);
+static struct bin_attribute bin_attr_weights =
+	__BIN_ATTR(weights, 0600, weights_read, weights_write,
+		   NAP_BLOB_SIZE);
+static NAP_BIN_ATTR_CONST struct bin_attribute *
+NAP_BIN_ATTR_CONST nap_bin_attrs[] = {
+	&bin_attr_weights,
+	NULL,
+};
+
+static struct attribute *nap_attrs[] = {
+	&version_attr.attr,
+	&simd_attr.attr,
+	&max_simd_attr.attr,
+	&stats_attr.attr,
+	&learning_rate_attr.attr,
+	&learn_attr.attr,
+	&budget_ppm_attr.attr,
+	&tick_stop_cost_attr.attr,
+	&tick_wake_cost_attr.attr,
+	&power_milli_attr.attr,
+	&reset_weights_attr.attr,
+	&reset_stats_attr.attr,
+	&weights_cpu_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group nap_attr_group = {
+	.attrs = nap_attrs,
+	.bin_attrs = nap_bin_attrs,
+};
+
+static struct kobject *nap_kobj;
+
+static int nap_sysfs_init(void)
+{
+	struct device *dev_root;
+	int ret;
+
+	dev_root = bus_get_dev_root(&cpu_subsys);
+	if (!dev_root)
+		return -ENODEV;
+
+	nap_kobj = kobject_create_and_add(NAP_SYSFS_NAME, &dev_root->kobj);
+	put_device(dev_root);
+	if (!nap_kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_group(nap_kobj, &nap_attr_group);
+	if (ret) {
+		kobject_put(nap_kobj);
+		nap_kobj = NULL;
+	}
+	return ret;
+}
+
+static void nap_sysfs_exit(void)
+{
+	if (nap_kobj) {
+		sysfs_remove_group(nap_kobj, &nap_attr_group);
+		kobject_put(nap_kobj);
+		nap_kobj = NULL;
+	}
+}
+
+/* ================================================================
+ * Governor registration
+ * ================================================================ */
+
+static struct cpuidle_governor nap_governor = {
+	.name    = NAP_GOV_NAME,
+	.rating  = NAP_RATING,
+	.enable  = nap_enable,
+	.select  = nap_select,
+	.reflect = nap_reflect,
+};
+
+/*
+ * Pick the highest SIMD level the processor offers, then verify every level
+ * up to it: forward pass against the offline model, one SGD step against the
+ * scalar reference.  A level that fails (and everything above it) is not
+ * used; if even the scalar reference disagrees with the offline model the
+ * governor does not register.
+ */
+static int __init nap_detect_simd(void)
+{
+	int isa, cap = NAP_ISA_SSE2;
+
+	if (boot_cpu_has(X86_FEATURE_AVX2) && boot_cpu_has(X86_FEATURE_FMA))
+		cap = NAP_ISA_AVX2;
+	if (cap == NAP_ISA_AVX2 && boot_cpu_has(X86_FEATURE_AVX512F))
+		cap = NAP_ISA_AVX512;
+
+	nap_isa_cpu = -1;
+	for (isa = NAP_ISA_SCALAR; isa <= cap; isa++) {
+		unsigned int wf, wl;
+		u64 f10, l10;
+		int n;
+
+		kernel_fpu_begin();
+		n = nap_fpu_selftest(isa, &wf, &wl);
+		kernel_fpu_end();
+		if (wf > 2000 || wl > 200) {
+			pr_warn("nap: %s self-test FAILED (forward %u e-6, learn %u e-6): not used\n",
+				nap_isa_name[isa], wf, wl);
+			break;
+		}
+		kernel_fpu_begin();
+		nap_fpu_bench(isa, &f10, &l10);
+		kernel_fpu_end();
+		pr_debug("nap: %-6s self-test ok (%d vectors, fwd %u e-6, learn %u e-6); forward %llu.%llu ns, learn %llu.%llu ns\n",
+			 nap_isa_name[isa], n, wf, wl,
+			 f10 / 10, f10 % 10, l10 / 10, l10 % 10);
+		nap_isa_cpu = isa;
+	}
+	return nap_isa_cpu >= NAP_ISA_SCALAR ? 0 : -EINVAL;
+}
+
+/* ~80 KB each: more than alloc_percpu() hands out, so allocate by hand */
+static void nap_free_cpus(void)
+{
+	int cpu;
+
+	if (!nap_cpus)
+		return;
+	for_each_possible_cpu(cpu)
+		kvfree(nap_cpus[cpu]);
+	kfree(nap_cpus);
+	nap_cpus = NULL;
+}
+
+static int __init nap_alloc_cpus(void)
+{
+	int cpu;
+
+	nap_cpus = kcalloc(nr_cpu_ids, sizeof(*nap_cpus), GFP_KERNEL);
+	if (!nap_cpus)
+		return -ENOMEM;
+	for_each_possible_cpu(cpu) {
+		nap_cpus[cpu] = kvzalloc_node(sizeof(**nap_cpus), GFP_KERNEL,
+					      cpu_to_node(cpu));
+		if (!nap_cpus[cpu]) {
+			nap_free_cpus();
+			return -ENOMEM;
+		}
+	}
+	return 0;
+}
+
+static int __init nap_init(void)
+{
+	int ret;
+
+	if (!may_use_simd())
+		return -EINVAL;
+	ret = nap_alloc_cpus();
+	if (ret)
+		return ret;
+
+	ret = nap_detect_simd();
+	if (ret) {
+		pr_err("nap: the network does not reproduce the offline model; not registering\n");
+		nap_free_cpus();
+		return ret;
+	}
+	nap_apply_isa();
+
+	ret = nap_sysfs_init();
+	if (ret)
+		pr_warn("nap: sysfs init failed: %d (continuing without sysfs)\n",
+			ret);
+
+	ret = nap_register_governor(&nap_governor);
+	if (ret) {
+		pr_err("nap: register_governor failed: %d\n", ret);
+		nap_sysfs_exit();
+		nap_free_cpus();
+		return ret;
+	}
+
+	pr_info("%s v%s by %s registered (rating=%u, simd=%s, processor supports up to %s)\n",
+		CPUIDLE_NAP_PROGNAME, CPUIDLE_NAP_VERSION, CPUIDLE_NAP_AUTHOR,
+		nap_governor.rating, nap_ops->name, nap_isa_name[nap_isa_cpu]);
+	return 0;
+}
+postcore_initcall(nap_init);
+
+#ifdef NAP_OOT
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("nap cpuidle governor (out-of-tree test build; cannot be unloaded)");
+#endif
diff --git a/drivers/cpuidle/governors/nap/nap.h b/drivers/cpuidle/governors/nap/nap.h
new file mode 100644
index 0000000000..29adb5753a
--- /dev/null
+++ b/drivers/cpuidle/governors/nap/nap.h
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef NAP_H
+#define NAP_H
+#include <linux/cpuidle.h>
+#include "nap_dims.h"
+
+#define NAP_HIST      6
+#define NAP_MAXSTATE  CPUIDLE_STATE_MAX
+#define NAP_WAKE_RING 128
+/* outputs padded to the widest vector (AVX-512: 16 lanes) */
+#define NAP_NOUTP     (((NAP_NOUT + 15) / 16) * 16)
+
+/* ISA ladder: the user sets the maximum, the CPU may cap it lower. */
+enum nap_isa {
+	NAP_ISA_SCALAR,
+	NAP_ISA_SSE2,
+	NAP_ISA_AVX2,
+	NAP_ISA_AVX512,
+	NAP_ISA_MAX
+};
+
+/*
+ * Integer signals gathered by the non-FPU side; all float work happens in
+ * the FPU translation units.
+ */
+struct nap_raw {
+	u64 sleep_ns, tick_ns, busy_ns;
+	/* net idle of the previous idles, [0] = most recent */
+	u64 hist_net[NAP_HIST];
+	u32 busy_irqs, idle_now, nr_cpus, wakes_50us, wakes_1ms;
+	u32 prev_d_dev, prev_d_loc, prev_d_cal;
+	s64 latency_req;
+	bool have_sample;
+	u64  last_T_net, last_O, last_tick, last_sleep, last_cycle;
+	bool last_stop, last_short;
+};
+
+/*
+ * Network state in SIMD-friendly layout.  The first layer is a table of rows
+ * (w1c[row][hidden]) and the input is sparse: NAP_NNZ (row, coefficient)
+ * pairs.  A time feature selects the two table rows around its value with
+ * linear-interpolation weights (a piecewise-linear embedding); a dense
+ * feature selects its own row with its standardised value.  Each pair is
+ * broadcast and FMA'd across all hidden neurons.  The output layer is
+ * w2r[hidden][out]: the forward pass broadcasts the hidden activation across
+ * the output vector; backprop dots each row with the output gradient (see
+ * nap_nn_gh.h).  The structure is ~80 KB, too big for alloc_percpu().
+ */
+struct nap_cpu {
+	float w1c[NAP_NROW][NAP_NHID];
+	float b1[NAP_NHID];
+	float w2r[NAP_NHID][NAP_NOUTP];
+	float b2[NAP_NOUTP];
+	float coef[NAP_NNZ];
+	u16 idx[NAP_NNZ];
+	float hid[NAP_NHID];
+	float logit[NAP_NOUTP];
+	float g[NAP_NOUTP];
+	float gh[NAP_NHID];
+	float S[NAP_NOUT];
+	float lambda, o_ewma, c_ewma;
+	bool fwd_valid, inited;
+
+	/* ---- integer side (nap.c) ---- */
+	int cached_min_state;		/* cached shallowest valid state */
+	s64 cached_min_state_latency;	/* latency_req at that time */
+	unsigned long cached_min_state_jiffies; /* jiffies at that time */
+	u64 total_residency_ns;
+	bool reset_pending;		/* set by sysfs, see nap_select */
+	u64 hist_net[NAP_HIST];
+	u64 prev_ref_ts;
+	u32 prev_tot_ref, prev_d_dev, prev_d_loc, prev_d_cal;
+	u64 ts_sel, sleep_ns, tick_ns;
+	u32 tot_sel, dev0, loc0, res0, cal0;
+	int sel_k;
+	bool sel_stop, active, short_circuited;
+	bool have_sample;
+	u64 last_T_net, last_O, last_tick, last_sleep, last_cycle;
+	bool last_stop, last_short;
+	u64 n_select, n_overshoot, n_learn, n_stop;
+	u64 lat_ns, lat_last;		/* avoidable wakeup latency */
+	u64 n_state[NAP_MAXSTATE];
+} __aligned(64);
+
+/* one per possible CPU, allocated node-local at init */
+extern struct nap_cpu **nap_cpus;
+
+/* one implementation per ISA; all operate on the same data layout */
+struct nap_nn_ops {
+	const char *name;
+	/* idx, coef -> hid, logit */
+	void (*forward)(struct nap_cpu *d);
+	/* SGD step; uses g (zero-padded), hid, idx, coef */
+	void (*learn)(struct nap_cpu *d, float lr);
+};
+extern const struct nap_nn_ops nap_nn_scalar, nap_nn_sse2, nap_nn_avx2,
+			       nap_nn_avx512;
+
+extern unsigned int nap_rho_ppm;	/* share of the time lost to avoidable wakeup latency */
+extern unsigned int nap_lr_micro;	/* online learning rate * 1e6 */
+extern unsigned int nap_pow_milli[NAP_MAXSTATE];
+extern unsigned int nap_c_stop_ns, nap_c_wake_ns;
+extern bool nap_learn;
+/* currently selected implementation */
+extern const struct nap_nn_ops *nap_ops;
+extern const char * const nap_isa_name[NAP_ISA_MAX];
+
+/* FPU entry points: call only inside kernel_fpu_begin()/end() */
+int  nap_fpu_select(struct cpuidle_driver *drv, struct cpuidle_device *dev,
+		    struct nap_cpu *d, const struct nap_raw *raw, bool *stop);
+void nap_fpu_init(struct nap_cpu *d);
+u32  nap_fpu_input_sig(void);
+int  nap_fpu_selftest(unsigned int isa, unsigned int *worst_fwd_e6,
+		      unsigned int *worst_learn_e6);
+const struct nap_nn_ops *nap_isa_ops(enum nap_isa isa);
+void nap_fpu_bench(unsigned int isa, u64 *fwd_ns10, u64 *learn_ns10);
+#endif
diff --git a/drivers/cpuidle/governors/nap/nap_dims.h b/drivers/cpuidle/governors/nap/nap_dims.h
new file mode 100644
index 0000000000..8815a7d5d2
--- /dev/null
+++ b/drivers/cpuidle/governors/nap/nap_dims.h
@@ -0,0 +1,18 @@
+/* generated by tools/export_ple.py -- do not edit */
+#ifndef NAP_DIMS_H
+#define NAP_DIMS_H
+/* time features, embedded piecewise linearly on 16 knots one octave apart */
+#define NAP_NT 8
+#define NAP_NK 16
+/* dense features */
+#define NAP_ND 8
+/* rows of the first-layer table and non-zero inputs per sample */
+#define NAP_NROW 136
+#define NAP_NNZ 24
+#define NAP_NHID 128
+#define NAP_NOUT 16
+#define NAP_GRID_LOG2_FIRST 9
+/* output g = P(idle >= 2^(NAP_GRID_LOG2_FIRST + g) ns); knot k of a time feature sits at log2 ns = NAP_GRID_LOG2_FIRST + k */
+/* mean idle time of the open-ended last bin, from the training data */
+#define NAP_TAIL_REP_NS 65504108
+#endif
diff --git a/drivers/cpuidle/governors/nap/nap_fpu.c b/drivers/cpuidle/governors/nap/nap_fpu.c
new file mode 100644
index 0000000000..9a217433ec
--- /dev/null
+++ b/drivers/cpuidle/governors/nap/nap_fpu.c
@@ -0,0 +1,505 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * nap_fpu.c -- scalar float work: features, decision, label construction.
+ * The network itself lives in the per-ISA files (nap_nn_*.c), selected
+ * through nap_ops.
+ */
+#include <linux/cpuidle.h>
+#include <linux/string.h>
+#include <linux/ktime.h>
+#include <linux/crc32.h>
+#include "nap.h"
+#include "nap_weights.h"
+#include "nap_selftest.h"
+
+/*
+ * ln(x) for x > 0 via exponent split + atanh series (error ~1e-8);
+ * log2 = ln * log2(e).
+ */
+static float nap_log2(float x)
+{
+	union { float f; u32 i; } u = { .f = x < 1.0f ? 1.0f : x };
+	int e = (int)((u.i >> 23) & 0xFF) - 127;
+	float m, y, y2, ln;
+
+	u.i = (u.i & 0x7FFFFFu) | (127u << 23);
+	m = u.f;
+	if (m > 1.41421356f) {
+		m *= 0.5f;
+		e++;
+	}
+	y = (m - 1.0f) / (m + 1.0f);
+	y2 = y * y;
+	ln = 2.0f * y * (1.0f + y2 * (1.0f / 3.0f +
+				      y2 * (1.0f / 5.0f + y2 * (1.0f / 7.0f))));
+	return (float)e + ln * 1.44269504f;
+}
+
+static float nap_log1p(float x)
+{
+	return nap_log2(1.0f + (x > 0.0f ? x : 0.0f)) * 0.69314718f;
+}
+
+static float nap_exp2(float x)
+{
+	union { u32 i; float f; } v;
+	int xi;
+	float f;
+
+	if (x > 60.0f)
+		x = 60.0f;
+	else if (x < -60.0f)
+		x = -60.0f;
+	xi = (int)x;
+	if (x < (float)xi)
+		xi--;
+	f = x - (float)xi;
+	v.i = (u32)((xi + 127) << 23);
+	return v.f * (1.0f + f * (0.6931472f +
+				  f * (0.2402265f +
+				       f * (0.0555041f + f * 0.0096181f))));
+}
+
+static float nap_sigmoid(float x)
+{
+	return 1.0f / (1.0f + nap_exp2(-1.44269504f * x));
+}
+
+static float flt(u64 v)
+{
+	return (float)(s64)v;
+}
+
+/*
+ * The 16 raw features, in the order used for training (tools/feats.py:
+ * F16).  Eight of them are times (log2 ns) and are embedded piecewise
+ * linearly, eight are dense (see nap_encode).
+ */
+#define NAP_NFEAT 16
+static void nap_features(const struct nap_raw *r, float x[NAP_NFEAT])
+{
+	float ls = nap_log2(flt(r->sleep_ns));
+	int i;
+
+	x[0] = ls > 30.0f ? 30.0f : ls;
+	x[1] = ls - nap_log2(flt(r->tick_ns));
+	x[2] = nap_log1p(flt(r->nr_cpus > r->idle_now ?
+			     r->nr_cpus - r->idle_now : 0));
+	x[3] = nap_log1p(flt(r->wakes_50us));
+	x[4] = nap_log1p(flt(r->wakes_1ms));
+	x[5] = nap_log2(flt(r->busy_ns));
+	x[6] = nap_log1p(flt(r->busy_irqs));
+	for (i = 0; i < NAP_HIST; i++)
+		x[7 + i] = nap_log2(flt(r->hist_net[i]));
+	x[13] = nap_log1p(flt(r->prev_d_dev));
+	x[14] = nap_log1p(flt(r->prev_d_loc));
+	x[15] = nap_log1p(flt(r->prev_d_cal));
+}
+
+/* position in the raw feature vector of the time / dense features */
+static const u8 nap_ti[NAP_NT] = { 0, 7, 8, 9, 10, 11, 12, 5 };
+static const u8 nap_di[NAP_ND] = { 1, 2, 3, 4, 6, 13, 14, 15 };
+
+/*
+ * Raw features -> sparse input of the first layer.  A time feature
+ * (log2 ns) selects the two knots around it, one octave apart starting at
+ * 2^NAP_GRID_LOG2_FIRST, with linear-interpolation weights; a dense
+ * feature is standardised.
+ */
+static void nap_encode(struct nap_cpu *d, const float x[NAP_NFEAT])
+{
+	const float top = (float)(NAP_NK - 1) - 1e-4f;
+	int t, i, n = 0;
+
+	for (t = 0; t < NAP_NT; t++) {
+		float u = x[nap_ti[t]] - (float)NAP_GRID_LOG2_FIRST;
+		int k;
+
+		u = u < 0.0f ? 0.0f : (u > top ? top : u);
+		k = (int)u;
+		d->idx[n] = t * NAP_NK + k;
+		d->coef[n++] = 1.0f - (u - (float)k);
+		d->idx[n] = t * NAP_NK + k + 1;
+		d->coef[n++] = u - (float)k;
+	}
+	for (i = 0; i < NAP_ND; i++) {
+		float c = (x[nap_di[i]] - nap_mu[i]) / nap_sd[i];
+
+#ifndef CONFIG_X86
+		/*
+		 * x86-only features (local timer, call-function IPI): the
+		 * weights were dropout-trained for their absence, so feed
+		 * the training mean.
+		 */
+		if (nap_di[i] >= 14)
+			c = 0.0f;
+#endif
+		d->idx[n] = NAP_NT * NAP_NK + i;
+		d->coef[n++] = c;
+	}
+}
+
+/*
+ * Encode the features, run the selected network, turn the logits into
+ * survival probabilities.
+ */
+static void nap_forward(const struct nap_nn_ops *ops, struct nap_cpu *d,
+			const float x[NAP_NFEAT])
+{
+	int i;
+
+	nap_encode(d, x);
+	ops->forward(d);
+	for (i = 0; i < NAP_NOUT; i++)
+		d->S[i] = nap_sigmoid(d->logit[i]);
+}
+
+void nap_fpu_init(struct nap_cpu *d)
+{
+	int i, j, o;
+
+	memset(d->w1c, 0, sizeof(d->w1c));
+	memset(d->w2r, 0, sizeof(d->w2r));
+	memset(d->b2, 0, sizeof(d->b2));
+	memset(d->g, 0, sizeof(d->g));
+	for (i = 0; i < NAP_NROW; i++)
+		/* header: rows of the first layer, [row][hidden] */
+		memcpy(d->w1c[i], &nap_w1[i * NAP_NHID], sizeof(d->w1c[i]));
+	memcpy(d->b1, nap_b1, sizeof(d->b1));
+	for (o = 0; o < NAP_NOUT; o++) {
+		d->b2[o] = nap_b2[o];
+		for (j = 0; j < NAP_NHID; j++)
+			/* header: [out][hidden] */
+			d->w2r[j][o] = nap_w2[o * NAP_NHID + j];
+	}
+	d->lambda = 1.0f;
+	d->o_ewma = 0.0f;
+	d->c_ewma = 0.0f;
+	d->fwd_valid = false;
+	d->inited = true;
+}
+
+/* identifies the input scaling the weights were trained with */
+u32 nap_fpu_input_sig(void)
+{
+	u32 c = crc32_le(~0, (const u8 *)nap_mu, sizeof(nap_mu));
+
+	return crc32_le(c, (const u8 *)nap_sd, sizeof(nap_sd));
+}
+
+const struct nap_nn_ops *nap_isa_ops(enum nap_isa isa)
+{
+	switch (isa) {
+	case NAP_ISA_AVX512:
+		return &nap_nn_avx512;
+	case NAP_ISA_AVX2:
+		return &nap_nn_avx2;
+	case NAP_ISA_SSE2:
+		return &nap_nn_sse2;
+	default:
+		return &nap_nn_scalar;
+	}
+}
+
+static float fabs_(float x)
+{
+	return x < 0.0f ? -x : x;
+}
+
+/*
+ * Self-test of one implementation against the offline model (forward) and
+ * against the scalar reference (one SGD step).  Returns the number of
+ * forward vectors checked.
+ */
+int nap_fpu_selftest(unsigned int isa, unsigned int *worst_fwd_e6,
+		     unsigned int *worst_learn_e6)
+{
+	static struct nap_cpu a, b;	/* init-time only, single caller */
+	const struct nap_nn_ops *ops = nap_isa_ops(isa);
+	float worst = 0.0f, wl = 0.0f;
+	const float *pa, *pb;
+	int v, k;
+	size_t n;
+
+	nap_fpu_init(&a);
+	for (v = 0; v < NAP_NSELFTEST; v++) {
+		nap_forward(ops, &a, &nap_st_in[v * NAP_NFEAT]);
+		for (k = 0; k < NAP_NOUT; k++) {
+			float e = fabs_(a.S[k] -
+					nap_st_out[v * NAP_NOUT + k]);
+
+			if (e > worst)
+				worst = e;
+		}
+	}
+	/* one learning step from the same state: scalar vs this ISA */
+	nap_fpu_init(&a);
+	nap_fpu_init(&b);
+	nap_forward(&nap_nn_scalar, &a, &nap_st_in[0]);
+	nap_forward(ops, &b, &nap_st_in[0]);
+	for (k = 0; k < NAP_NOUT; k++)
+		a.g[k] = b.g[k] = (k & 1) ? -0.37f : 0.52f;
+	nap_nn_scalar.learn(&a, 0.01f);
+	ops->learn(&b, 0.01f);
+	pa = (const float *)a.w1c;
+	pb = (const float *)b.w1c;
+	n = (sizeof(a.w1c) + sizeof(a.b1) + sizeof(a.w2r) + sizeof(a.b2)) /
+	    sizeof(float);
+	/* the four weight arrays are contiguous at the start of nap_cpu */
+	for (k = 0; k < (int)n; k++) {
+		float e = fabs_(pa[k] - pb[k]);
+
+		if (e > wl)
+			wl = e;
+	}
+	*worst_fwd_e6 = (unsigned int)(worst * 1e6f);
+	*worst_learn_e6 = (unsigned int)(wl * 1e6f);
+	return NAP_NSELFTEST;
+}
+
+/*
+ * Bins of the idle-time distribution implied by the grid: bin 0 = below
+ * 2^FIRST, bin b (1..G-1) = [2^(FIRST+b-1), 2^(FIRST+b)), bin G = beyond the
+ * last point (its representative time, NAP_TAIL_REP_NS, comes from the
+ * training data).
+ */
+#define NB (NAP_NOUT + 1)
+
+static void nap_bin_times(float Tb[NB])
+{
+	int b;
+
+	Tb[0] = (float)(1ULL << (NAP_GRID_LOG2_FIRST - 1));
+	for (b = 1; b < NAP_NOUT; b++)
+		/* mean of a log-uniform bin [t, 2t) */
+		Tb[b] = 1.4427f *
+			(float)(1ULL << (NAP_GRID_LOG2_FIRST - 1 + b));
+	Tb[NAP_NOUT] = (float)NAP_TAIL_REP_NS;
+}
+
+/*
+ * Masked BCE SGD step on the previous idle's stored z / hid / S.
+ * Label g = [idle >= 2^(FIRST+g)].
+ */
+static void nap_learn_step(const struct nap_nn_ops *ops, struct nap_cpu *d,
+			   const struct nap_raw *r)
+{
+	float lr = (float)nap_lr_micro * 1e-6f;
+	float T = flt(r->last_T_net), tick = flt(r->last_tick);
+	bool cens = !r->last_stop && r->last_tick < r->last_sleep &&
+		    T >= 0.9f * tick;
+	int o;
+
+	for (o = 0; o < NAP_NOUT; o++) {
+		float thr = (float)(1ULL << (NAP_GRID_LOG2_FIRST + o));
+		float y = thr <= T ? 1.0f : 0.0f;
+		/* unknown above the tick when censored */
+		float m = (cens && thr > T) ? 0.0f : 1.0f;
+
+		d->g[o] = m * (d->S[o] - y);
+	}
+	ops->learn(d, lr);
+}
+
+/* deepest enabled state whose target residency fits into T */
+static int nap_ideal(const float *tgt, int ns, struct cpuidle_device *dev,
+		     float T)
+{
+	int j;
+
+	for (j = ns - 1; j > 0; j--)
+		if (!dev->states_usage[j].disable && tgt[j] <= T)
+			return j;
+	return 0;
+}
+
+int nap_fpu_select(struct cpuidle_driver *drv, struct cpuidle_device *dev,
+		   struct nap_cpu *d, const struct nap_raw *r, bool *stop)
+{
+	const struct nap_nn_ops *ops = READ_ONCE(nap_ops);
+	float tgt[NAP_MAXSTATE], e0[NAP_MAXSTATE], pw[NAP_MAXSTATE];
+	float Sm[NAP_NOUT], p[NB], Tb[NB], nf[NB], rem[NB];
+	float ex[NAP_MAXSTATE];
+	int kb[NB], kc[NB];
+	float x[NAP_NFEAT], tick, lam, best = -1e30f;
+	float cs = (float)nap_c_stop_ns, cw = (float)nap_c_wake_ns;
+	float rho = (float)nap_rho_ppm, cur;
+	int k, b, bk = 0, i, ns = drv->state_count;
+	bool bs = false;
+
+	if (ns > NAP_MAXSTATE)
+		ns = NAP_MAXSTATE;
+	for (k = 0; k < ns; k++) {
+		tgt[k] = (float)drv->states[k].target_residency_ns;
+		ex[k] = (float)drv->states[k].exit_latency_ns;
+		pw[k] = (float)nap_pow_milli[k] * 1e-3f;
+	}
+	e0[0] = 0.0f;
+	for (k = 1; k < ns; k++)
+		e0[k] = e0[k - 1] + (pw[k - 1] - pw[k]) * tgt[k];
+
+	if (unlikely(!d->inited || d->reset_pending)) {
+		nap_fpu_init(d);
+		d->reset_pending = false;
+	}
+
+	/*
+	 * Feedback from the previous idle: learning step and the controller
+	 * that keeps the share of the time lost to avoidable wakeup latency at
+	 * the budget.
+	 */
+	if (r->have_sample && !r->last_short) {
+		if (nap_learn && d->fwd_valid) {
+			nap_learn_step(ops, d, r);
+			d->n_learn++;
+			d->fwd_valid = false;
+		}
+		d->o_ewma += (flt(r->last_O) - d->o_ewma) * (1.0f / 64.0f);
+		d->c_ewma += (flt(r->last_cycle) - d->c_ewma) * (1.0f / 64.0f);
+		/* lost share of the time, in ppm */
+		cur = d->c_ewma > 1.0f ? d->o_ewma / d->c_ewma * 1e6f : 0.0f;
+		if (cur > rho * 1.05f)
+			d->lambda *= 1.02f;
+		else if (cur < rho)
+			d->lambda *= 0.98f;
+		if (d->lambda < 1e-4f)
+			d->lambda = 1e-4f;
+		if (d->lambda > 1e4f)
+			d->lambda = 1e4f;
+	}
+
+	nap_features(r, x);
+	nap_forward(ops, d, x);
+	d->fwd_valid = true;
+
+	/*
+	 * The distribution of the tick-unbounded idle time: monotone
+	 * survival -> bin probabilities.
+	 */
+	Sm[0] = d->S[0];
+	for (i = 1; i < NAP_NOUT; i++)
+		Sm[i] = d->S[i] < Sm[i - 1] ? d->S[i] : Sm[i - 1];
+	p[0] = 1.0f - Sm[0];
+	for (b = 1; b < NAP_NOUT; b++)
+		p[b] = Sm[b - 1] - Sm[b];
+	p[NAP_NOUT] = Sm[NAP_NOUT - 1];
+
+	tick = flt(r->tick_ns);
+	if (tick < 1.0f)
+		tick = 1.0f;
+	lam = d->lambda;
+	nap_bin_times(Tb);
+	for (b = 0; b < NB; b++) {
+		nf[b] = (float)(s64)(Tb[b] / tick);
+		rem[b] = Tb[b] - nf[b] * tick;
+		/*
+		 * State that would have been right for the whole idle (tick
+		 * stopped) and for its last piece (tick kept).
+		 */
+		kb[b] = nap_ideal(tgt, ns, dev, Tb[b]);
+		kc[b] = nap_ideal(tgt, ns, dev, rem[b] > 0.0f ? rem[b] : tick);
+	}
+
+	/*
+	 * Joint (state, stop-tick) choice maximising
+	 * -E[energy] - lambda * E[avoidable wakeup latency].
+	 */
+	for (k = 0; k < ns; k++) {
+		float keep_e = e0[k] + pw[k] * tick + cw;
+
+		for (i = 0; i < 2; i++) {
+			bool st = i;
+			float E = 0.0f, O = 0.0f, v;
+
+			if (k == 0 && st)
+				continue;
+			/*
+			 * Nothing to gain from stopping the tick when the next
+			 * timer is closer than one tick period, and a stopped
+			 * tick makes the wakeup slow (measured: ~100 us on
+			 * average on Zen 4).
+			 */
+			if (st && r->sleep_ns < TICK_NSEC)
+				continue;
+			for (b = 0; b < NB; b++) {
+				float T = Tb[b], e, o;
+
+				if (p[b] < 1e-4f)
+					continue;
+				if (k == 0) {
+					e = pw[0] * T;
+					o = 0.0f;
+				} else if (st) {
+					e = e0[k] + pw[k] * T + cs;
+					/* avoidable wakeup latency */
+					o = ex[k] > ex[kb[b]] ?
+					    ex[k] - ex[kb[b]] : 0.0f;
+				} else {
+					e = nf[b] * keep_e;
+					/* ... from the last piece's state */
+					o = ex[k] > ex[kc[b]] ?
+					    ex[k] - ex[kc[b]] : 0.0f;
+					if (rem[b] > 0.0f) {
+						e += e0[k] + pw[k] * rem[b] +
+						     cw;
+					}
+				}
+				E += p[b] * e;
+				O += p[b] * o;
+			}
+			v = -E - lam * O;
+			if (v > best) {
+				best = v;
+				bk = k;
+				bs = st;
+			}
+		}
+	}
+
+	/*
+	 * Honour PM QoS and disabled states: fall back to the next shallower
+	 * valid one.
+	 */
+	for (k = bk; k >= 1; k--) {
+		if (dev->states_usage[k].disable)
+			continue;
+		if ((s64)drv->states[k].exit_latency_ns > r->latency_req)
+			continue;
+		break;
+	}
+	if (k < 1) {
+		k = 0;
+		bs = false;
+	}
+	*stop = k ? bs : false;
+	return k;
+}
+
+/*
+ * Time forward and learn of one implementation (average over many calls,
+ * FPU section held by the caller).
+ */
+void nap_fpu_bench(unsigned int isa, u64 *fwd_ns10, u64 *learn_ns10)
+{
+	static struct nap_cpu b;
+	const struct nap_nn_ops *ops = nap_isa_ops(isa);
+	const int n = 2000;
+	u64 t0, t1, t2;
+	int i, k;
+
+	nap_fpu_init(&b);
+	for (k = 0; k < NAP_NOUT; k++)
+		b.g[k] = (k & 1) ? -0.01f : 0.01f;
+	nap_forward(ops, &b, &nap_st_in[0]);
+	t0 = ktime_get_ns();
+	for (i = 0; i < n; i++) {
+		b.coef[0] = (float)(i & 7);
+		ops->forward(&b);
+	}
+	t1 = ktime_get_ns();
+	for (i = 0; i < n; i++)
+		ops->learn(&b, 1e-6f);
+	t2 = ktime_get_ns();
+	*fwd_ns10 = (t1 - t0) * 10 / n;
+	*learn_ns10 = (t2 - t1) * 10 / n;
+}
