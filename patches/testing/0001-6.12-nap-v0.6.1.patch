diff --git a/drivers/cpuidle/governors/nap/nap_nn_gh.h b/drivers/cpuidle/governors/nap/nap_nn_gh.h
new file mode 100644
index 0000000000..fc06559c37
--- /dev/null
+++ b/drivers/cpuidle/governors/nap/nap_nn_gh.h
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * gh = relu'(hid) * (W2 g): the hidden-layer gradient, hand-tuned per vector
+ * width.  Included by nap_nn_impl.h after the vector types and helpers.
+ *
+ * Each w2r row is dotted with the output gradient g, NAP_VL rows at a time;
+ * the NAP_VL vectors of partial sums are then reduced to one vector (lane i =
+ * sum of row i) with a transpose-add tree.  Keeping the output layer in a
+ * single w2r[hidden][out] layout and reducing with a tree is cheaper than
+ * keeping a transposed copy up to date (measured on Zen 4 and Zen 5).
+ *
+ * Built-ins are used instead of <immintrin.h>, which the kernel cannot use:
+ * __builtin_ia32_haddps256 / __builtin_ia32_vperm2f128_ps256 exist in both
+ * GCC and clang, and __builtin_shufflevector needs GCC 12 or clang (see
+ * Kconfig).
+ */
+
+#if NAP_VL == 4
+/* SSE2: 4 rows at a time, unpack tree */
+static inline void NAP_SYM(gh)(struct nap_cpu *d, const vf g[OV])
+{
+	int j, r, k;
+
+	for (j = 0; j < NAP_NHID; j += 4) {
+		vf s[4], u0, u1, sum;
+		vi m;
+
+		for (r = 0; r < 4; r++) {
+			vf a = ld(&d->w2r[j + r][0]) * g[0];
+
+			for (k = 1; k < OV; k++)
+				a += ld(&d->w2r[j + r][k * 4]) * g[k];
+			s[r] = a;
+		}
+		u0 = __builtin_shufflevector(s[0], s[1], 0, 4, 1, 5) +
+		     __builtin_shufflevector(s[0], s[1], 2, 6, 3, 7);
+		u1 = __builtin_shufflevector(s[2], s[3], 0, 4, 1, 5) +
+		     __builtin_shufflevector(s[2], s[3], 2, 6, 3, 7);
+		sum = __builtin_shufflevector(u0, u1, 0, 1, 4, 5) +
+		      __builtin_shufflevector(u0, u1, 2, 3, 6, 7);
+		m = ld(&d->hid[j]) > (vf){ 0 };
+		st(&d->gh[j], (vf)((vi)sum & m));
+	}
+}
+
+#elif NAP_VL == 8 || NAP_VL == 16
+/* AVX2: 8 rows at a time, hadd tree */
+typedef float vf8 __attribute__((vector_size(32)));
+typedef int   vi8 __attribute__((vector_size(32)));
+
+static inline vf8 NAP_SYM(tree8)(vf8 s[8])
+{
+	vf8 t0 = __builtin_ia32_haddps256(s[0], s[1]);
+	vf8 t1 = __builtin_ia32_haddps256(s[2], s[3]);
+	vf8 t2 = __builtin_ia32_haddps256(s[4], s[5]);
+	vf8 t3 = __builtin_ia32_haddps256(s[6], s[7]);
+	vf8 u0 = __builtin_ia32_haddps256(t0, t1);
+	vf8 u1 = __builtin_ia32_haddps256(t2, t3);
+
+	return __builtin_ia32_vperm2f128_ps256(u0, u1, 0x20) +
+	       __builtin_ia32_vperm2f128_ps256(u0, u1, 0x31);
+}
+
+static inline void NAP_SYM(gh)(struct nap_cpu *d, const vf g[OV])
+{
+	int j, r, k;
+
+	for (j = 0; j < NAP_NHID; j += 8) {
+		vf8 s[8], sum, h;
+		vi8 m;
+
+		for (r = 0; r < 8; r++) {
+#if NAP_VL == 8
+			vf a = ld(&d->w2r[j + r][0]) * g[0];
+
+			for (k = 1; k < OV; k++)
+				a += ld(&d->w2r[j + r][k * 8]) * g[k];
+			s[r] = a;
+#else
+			/* AVX-512: one 16-lane row; fold it to 8 lanes first */
+			vf p = ld(&d->w2r[j + r][0]) * g[0];
+
+			(void)k;
+			s[r] = __builtin_shufflevector(p, p, 0, 1, 2, 3, 4, 5,
+						       6, 7) +
+			       __builtin_shufflevector(p, p, 8, 9, 10, 11, 12,
+						       13, 14, 15);
+#endif
+		}
+		sum = NAP_SYM(tree8)(s);
+		__builtin_memcpy(&h, &d->hid[j], sizeof(h));
+		m = h > (vf8){ 0 };
+		sum = (vf8)((vi8)sum & m);
+		__builtin_memcpy(&d->gh[j], &sum, sizeof(sum));
+	}
+}
+#else
+#error "unsupported vector width"
+#endif
diff --git a/drivers/cpuidle/governors/nap/nap_nn_impl.h b/drivers/cpuidle/governors/nap/nap_nn_impl.h
new file mode 100644
index 0000000000..d0f56e42b1
--- /dev/null
+++ b/drivers/cpuidle/governors/nap/nap_nn_impl.h
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Shared body of the SIMD implementations.  The including file defines
+ * NAP_VL (floats per vector) and NAP_SYM(name) before including.  GCC vector
+ * extensions are used (no <immintrin.h> in the kernel); the compiler lowers
+ * them to SSE2 / AVX2+FMA / AVX-512 according to the flags of the including
+ * file.
+ */
+#include <linux/string.h>
+#include "nap.h"
+
+typedef float vf __attribute__((vector_size(NAP_VL * 4)));
+typedef int   vi __attribute__((vector_size(NAP_VL * 4)));
+
+#define HV (NAP_NHID / NAP_VL)
+#define OV (NAP_NOUTP / NAP_VL)
+
+static inline vf ld(const float *p)
+{
+	vf v;
+
+	__builtin_memcpy(&v, p, sizeof(v));
+	return v;
+}
+
+static inline void st(float *p, vf v)
+{
+	__builtin_memcpy(p, &v, sizeof(v));
+}
+
+static inline vf bc(float x)
+{
+	vf v;
+	int l;
+
+	for (l = 0; l < NAP_VL; l++)
+		v[l] = x;
+	return v;
+}
+
+static inline vf relu(vf a)
+{
+	vi m = a > (vf){ 0 };		/* all-ones where a > 0 */
+
+	return (vf)((vi)a & m);
+}
+
+/*
+ * Both layers accumulate into two independent sets of vectors (even and odd
+ * terms) that are added at the end.  With a single set, the chain of
+ * dependent FMAs (one per input / hidden neuron) is limited by the FMA
+ * latency instead of the throughput.
+ */
+static_assert(NAP_NNZ % 2 == 0 && NAP_NHID % 2 == 0);
+
+static void NAP_SYM(forward)(struct nap_cpu *d)
+{
+	vf h[HV], h2[HV], o[OV], o2[OV];
+	int i, j, k;
+
+	for (k = 0; k < HV; k++) {
+		h[k] = ld(&d->b1[k * NAP_VL]);
+		h2[k] = (vf){ 0 };
+	}
+	for (i = 0; i < NAP_NNZ; i += 2) {
+		vf zi = bc(d->coef[i]), zj = bc(d->coef[i + 1]);
+		const float *ri = d->w1c[d->idx[i]];
+		const float *rj = d->w1c[d->idx[i + 1]];
+
+		for (k = 0; k < HV; k++) {
+			h[k] += zi * ld(&ri[k * NAP_VL]);
+			h2[k] += zj * ld(&rj[k * NAP_VL]);
+		}
+	}
+	for (k = 0; k < HV; k++) {
+		h[k] = relu(h[k] + h2[k]);
+		st(&d->hid[k * NAP_VL], h[k]);
+	}
+	for (k = 0; k < OV; k++) {
+		o[k] = ld(&d->b2[k * NAP_VL]);
+		o2[k] = (vf){ 0 };
+	}
+	for (j = 0; j < NAP_NHID; j += 2) {
+		vf hj = bc(d->hid[j]), hk = bc(d->hid[j + 1]);
+
+		for (k = 0; k < OV; k++) {
+			o[k] += hj * ld(&d->w2r[j][k * NAP_VL]);
+			o2[k] += hk * ld(&d->w2r[j + 1][k * NAP_VL]);
+		}
+	}
+	for (k = 0; k < OV; k++)
+		st(&d->logit[k * NAP_VL], o[k] + o2[k]);
+}
+
+#include "nap_nn_gh.h"
+
+static void NAP_SYM(learn)(struct nap_cpu *d, float lr)
+{
+	vf g[OV], gh[HV];
+	int i, j, k;
+
+	for (k = 0; k < OV; k++)
+		g[k] = ld(&d->g[k * NAP_VL]);
+	NAP_SYM(gh)(d, g);
+	for (k = 0; k < HV; k++)
+		gh[k] = ld(&d->gh[k * NAP_VL]);
+
+	/* output layer, then bias */
+	for (j = 0; j < NAP_NHID; j++) {
+		vf c = bc(lr * d->hid[j]);
+
+		for (k = 0; k < OV; k++)
+			st(&d->w2r[j][k * NAP_VL],
+			   ld(&d->w2r[j][k * NAP_VL]) - c * g[k]);
+	}
+	for (k = 0; k < OV; k++)
+		st(&d->b2[k * NAP_VL],
+		   ld(&d->b2[k * NAP_VL]) - bc(lr) * g[k]);
+
+	/* hidden layer */
+	for (i = 0; i < NAP_NNZ; i++) {
+		vf c = bc(lr * d->coef[i]);
+		float *r = d->w1c[d->idx[i]];
+
+		for (k = 0; k < HV; k++)
+			st(&r[k * NAP_VL], ld(&r[k * NAP_VL]) - c * gh[k]);
+	}
+	for (k = 0; k < HV; k++)
+		st(&d->b1[k * NAP_VL],
+		   ld(&d->b1[k * NAP_VL]) - bc(lr) * gh[k]);
+}
diff --git a/drivers/cpuidle/governors/nap/nap_nn_scalar.c b/drivers/cpuidle/governors/nap/nap_nn_scalar.c
new file mode 100644
index 0000000000..66f1f8b1ff
--- /dev/null
+++ b/drivers/cpuidle/governors/nap/nap_nn_scalar.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Scalar implementation: plain loops, no vectorisation.  It is the
+ * reference the other implementations are checked against at boot.
+ */
+#include "nap.h"
+
+static void nap_scalar_forward(struct nap_cpu *d)
+{
+	int i, j, o;
+
+	for (j = 0; j < NAP_NHID; j++) {
+		float a = d->b1[j];
+
+		for (i = 0; i < NAP_NNZ; i++)
+			a += d->w1c[d->idx[i]][j] * d->coef[i];
+		d->hid[j] = a > 0.0f ? a : 0.0f;
+	}
+	for (o = 0; o < NAP_NOUTP; o++) {
+		float a = d->b2[o];
+
+		for (j = 0; j < NAP_NHID; j++)
+			a += d->w2r[j][o] * d->hid[j];
+		d->logit[o] = a;
+	}
+}
+
+static void nap_scalar_learn(struct nap_cpu *d, float lr)
+{
+	int i, j, o;
+
+	for (j = 0; j < NAP_NHID; j++) {
+		float a = 0.0f;
+
+		for (o = 0; o < NAP_NOUT; o++)
+			a += d->w2r[j][o] * d->g[o];
+		d->gh[j] = d->hid[j] > 0.0f ? a : 0.0f;
+	}
+	for (j = 0; j < NAP_NHID; j++)
+		for (o = 0; o < NAP_NOUTP; o++)
+			d->w2r[j][o] -= lr * d->hid[j] * d->g[o];
+	for (o = 0; o < NAP_NOUTP; o++)
+		d->b2[o] -= lr * d->g[o];
+	for (i = 0; i < NAP_NNZ; i++)
+		for (j = 0; j < NAP_NHID; j++)
+			d->w1c[d->idx[i]][j] -= lr * d->coef[i] * d->gh[j];
+	for (j = 0; j < NAP_NHID; j++)
+		d->b1[j] -= lr * d->gh[j];
+}
+
+const struct nap_nn_ops nap_nn_scalar = {
+	.name = "scalar",
+	.forward = nap_scalar_forward,
+	.learn = nap_scalar_learn,
+};
